   <item>
    <widget class="QGroupBox"><property name="title"><string>Power timer</string></property>
     <layout class="QVBoxLayout">
      <item><widget class="QLabel"><property name="text"><string>Schedule an automatic power action after a set time. Requires administrator authorization.</string></property><property name="wordWrap"><bool>true</bool></property><property name="styleSheet"><string>color:#6c7086;</string></property></widget></item>
      <item>
       <layout class="QHBoxLayout">
