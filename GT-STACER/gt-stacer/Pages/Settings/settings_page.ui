    <widget class="QGroupBox"><property name="title"><string>Behavior</string></property>
     <layout class="QVBoxLayout">
      <item><widget class="QCheckBox" name="autoStartCheck"><property name="text"><string>Start GT-STACER on system login</string></property></widget></item>
      <item><widget class="QCheckBox" name="startMinimizedCheck"><property name="text"><string>Start minimized</string></property></widget></item>
